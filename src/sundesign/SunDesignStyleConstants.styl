// sizes
size-small = 18px
size-normal = 24px
size-large = 32px

padding-small = 1px
padding-normal = 3px
padding-large = 5px

padding-extend-small = 4px
padding-extend-normal = 6px
padding-extend-large = 8px

content-size-small = 13px // size-small - padding-small * 2
content-size-normal = 16px // size-normal - padding-normal * 2
content-size-large = 20px // size-large - padding-large * 2

font-size-small = 10px
font-size-normal = 12px
font-size-large = 16px

border-radius-size-small = 4px
border-radius-size-normal = 6px
border-radius-size-large = 8px

gap-small = 2px
gap-normal = 4px
gap-large = 6px

border-width = 1px

solid-border = border-width var(--border-color-normal) solid
solid-border-disabled = border-width var(--border-color-disabled) solid
solid-border-active-disabled = border-width var(--border-color-active-disabled) solid

focus-width = 2px
focus-offset = - focus-width // - border-width

// colors
panel-color = rgb(255, 255, 255)
panel-padding = 4px
panel-border-radius-small = border-radius-size-small + panel-padding
panel-border-radius-normal = border-radius-size-normal + panel-padding
panel-border-radius-large = border-radius-size-large + panel-padding

focus-color = rgba(79, 79, 79, 0.4)
border-color-normal = #d3d3d3
border-color-disabled = #dcdcdc
border-color-active-disabled = #dcdcdc
placeholder-color = #a3a3a3
placeholder-color-disabled = #dcdcdc

color-normal = #f1f1f1
color-hover = #e4e4e4
color-pressed = #4f4f4f
color-disabled = #f9f9f9

color-active = #4f4f4f
color-active-hover = #606060
color-active-pressed = #e7e7e7
color-active-disabled = #b0b0b0

font-color-normal = #4f4f4f
font-color-hover = #4f4f4f
font-color-pressed = #ffffff
font-color-disabled = #c8c8c8

font-color-active = #ffffff
font-color-active-hover = #ffffff
font-color-active-pressed = #4f4f4f
font-color-active-disabled = #ffffff