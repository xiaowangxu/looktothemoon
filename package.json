{
  "name": "looktothemoon",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build-vfs-code & vite",
    "dev-host": "npm run build-vfs-code & vite --host",
    "build": "npm run build-vfs-code & run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "npm run build-vfs-code & vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "build-fs-saveload-code": "tsc src/system/filesystem/fs_saver_loader/FileSystemSaverLoader.mjs --declaration --allowJs --emitDeclarationOnly",
    "build-vfs": "node dev/vfs_gen/VfsGen.mjs res/vfs res/sys.vfs",
    "build-vfs-code": "npm run build-fs-saveload-code & npm run build-vfs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@vueuse/components": "^10.5.0",
    "@vueuse/core": "^10.5.0",
    "expr-eval": "^2.0.2",
    "lucide-vue-next": "^0.284.0",
    "lz-string": "^1.5.0",
    "spark-md5": "^3.0.2",
    "three": "^0.157.0",
    "three-mesh-bvh": "^0.6.8",
    "vue": "^3.4.15"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.8",
    "@storybook/addon-interactions": "^7.6.8",
    "@storybook/addon-links": "^7.6.8",
    "@storybook/blocks": "^7.6.8",
    "@storybook/test": "^7.6.8",
    "@storybook/vue3": "^7.6.8",
    "@storybook/vue3-vite": "^7.6.8",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.17.17",
    "@types/spark-md5": "^3.0.4",
    "@types/three": "^0.156.0",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vue/tsconfig": "^0.4.0",
    "npm-run-all2": "^6.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^7.6.8",
    "stylus": "^0.62.0",
    "typescript": "~5.2.0",
    "vite": "^4.4.9",
    "vue-tsc": "^1.8.11"
  }
}
